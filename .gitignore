node_modules/
dist/
.DS_Store
.env
.env.*
!.env.example

# secrets — never commit
cloudflare-token.txt
*-token.txt

pipeline/.cache/
pipeline/.venv/
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Claude Code: ignore personal/local config under .claude/, but keep
# the repo-wide subagent definitions in .claude/agents/ tracked so
# every contributor gets the same QA tooling (e.g. the verifier).
.claude/*
!.claude/agents/
!.claude/agents/**

# Validation per-cell archive — too big to commit (~700 KB/day gzipped,
# ~250 MB/year) and only used by the inline scoring step on the same CI
# disk. observations.jsonl, residuals.jsonl, and per_zone_metrics.json
# ARE committed (small, durable signal).
pipeline/validation/data/archive/

# Ingest-side download caches. The RCCA zip (~30 MB) is a historical
# agency dataset; we cache it on the runner's disk between cron ticks
# rather than re-downloading every hour. Anything that lives under
# _cache/ is reproducible from a re-fetch.
pipeline/validation/ingest/_cache/

# Stale: previously held the Flutter web bundle (retired 2026-05-04).
# Ignore stays so any leftover local builds don't accidentally land in a
# commit; safe to delete entirely once everyone's working trees are clean.
public/app/

# Expo / React Native
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/
mobile/test-output/
mobile/*.jks
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/.env*
