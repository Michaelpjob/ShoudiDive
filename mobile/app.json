{
  "expo": {
    "name": "ShouldIDive",
    "slug": "shouldidive",
    "scheme": "shouldidive",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0369a1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shouldidive.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShouldIDive can show conditions at your current location and let you tap-to-pin a value at a real spot."
      }
    },
    "android": {
      "package": "com.shouldidive.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0369a1"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location"
    ]
  }
}
